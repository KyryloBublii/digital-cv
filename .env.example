# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# GitHub
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=github_pat_...
GITHUB_PORTFOLIO_DATA_REPO=KyryloBublii/portfolio-data
GITHUB_PORTFOLIO_DATA_TOKEN=github_pat_...   # falls back to GITHUB_TOKEN if omitted

# Email (Resend)
RESEND_API_KEY=re_...
MAIL_FROM=noreply@kyrylobublii.com
MAIL_RECIPIENT=your@email.com

# Cloudflare Turnstile (contact form bot protection)
TURNSTILE_SECRET=0x4AAA...
TURNSTILE_SITE_KEY=0x4AAA...

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_key
